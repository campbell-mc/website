# =============================================================================
# CHRIS Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Neon (Database) ---
# Find at: console.neon.tech → Your Project → Connection Details → Connection string
DATABASE_URL=postgresql://neondb_owner:your-password@ep-your-endpoint.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Anthropic (Claude API for intelligence engines) ---
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Resend (Email delivery) ---
# Get from: resend.com → API Keys
RESEND_API_KEY=re_your-key-here

# --- LinqApp (iMessage delivery for magic links + alerts) ---
# Get from: linqapp.com → API Settings
LINQAPP_API_KEY=your-linqapp-api-key

# --- Twilio (SMS fallback) ---
# Get from: twilio.com → Console → Account Info
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+61XXXXXXXXX

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
